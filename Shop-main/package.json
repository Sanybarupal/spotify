{
  "name": "golf-commerce-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:storefront": "npm run dev --workspace @golf-commerce/storefront",
    "dev:api": "npm run start:dev --workspace @golf-commerce/api",
    "db:migrate": "npm run db:migrate --workspace @golf-commerce/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
